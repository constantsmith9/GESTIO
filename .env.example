# =========================================================================
# GESTIO - Backend SaaSPay & Webhook Configuration
# =========================================================================

# Port du serveur HTTP
PORT=3000

# Clé secrète SaaSPay depuis le tableau de bord marchand (ne jamais committer une vraie valeur)
SAASPAY_SECRET_KEY=

# Secret de signature du Webhook SaaSPay pour authentifier les notifications
SAASPAY_WEBHOOK_SECRET=

# URL de l'API SaaSPay (ex: https://api.saaspay.app/v1 ou URL fournie par votre documentation)
SAASPAY_API_BASE_URL=https://api.saaspay.app/v1

# Sur Render, monter un disque persistant sur /var/data avant de définir ce chemin.
SUBSCRIPTIONS_FILE=/var/data/subscriptions.json

# URL de redirection après paiement réussi / annulé (Deep link ou page web)
APP_SUCCESS_URL=https://gestio.app/payment-success
APP_CANCEL_URL=https://gestio.app/payment-cancelled
